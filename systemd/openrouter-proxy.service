[Unit]
Description=OpenRouter proxy sidecar (local-only, feeds webui chat the OpenRouter option)
After=network.target

[Service]
Type=simple
User=josh
WorkingDirectory=/home/josh/openbench-toolkit
EnvironmentFile=/var/secrets/moe-vram-pager.env
ExecStart=/home/josh/MetasploitMCP/.venv/bin/python /home/josh/openbench-toolkit/tools/openrouter_proxy.py --host 127.0.0.1 --port 8087
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
