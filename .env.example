# openbench-toolkit secrets, example file.
#
# Copy this to one of the locations the resolver checks (first existing wins):
#   1. wherever $OPENBENCH_ENV_FILE points
#   2. ${XDG_CONFIG_HOME:-~/.config}/openbench-toolkit/secrets.env
#   3. <repo root>/.env          (this directory; git-ignored)
#   4. ~/secrets/moe-vram-pager.env   (on Windows: %USERPROFILE%\secrets\moe-vram-pager.env -
#                                      same file setup-pentest-mcp.ps1 already uses for MSF_PASSWORD)
#   5. /var/secrets/moe-vram-pager.env   (legacy default on the original Linux box)
#
# The core moe-vram-pager server needs none of these. Most are only used by
# the pentest layer; OPENROUTER_API_KEY is the exception - it's also read by
# the openrouter-proxy sidecar that backs the chat UI's OpenRouter option.
# Never commit a filled-in copy.

# msfrpcd local RPC auth (loopback only, port 55553). Not a real credential:
# pick anything, or let tools/setup_pentest_appliance.sh generate one.
MSF_PASSWORD=

# ZAP daemon REST API auth (loopback only, port 8090). Same idea as MSF_PASSWORD.
ZAP_API_KEY=

# Optional. Real external account: Brave Search API (free tier, 2,000 queries/
# month). Sharpens google_dork_search operator precision. Falls back to
# DuckDuckGo HTML results when unset.
BRAVE_API_KEY=

# Optional. Real external account: NIST NVD API key. Raises the rate limit on
# cve_lookup / cve_lookup_cpe. Lookups still work without it at the public rate.
NVD_API_KEY=

# Optional. Real external account: your OpenRouter API key (https://openrouter.ai/keys).
# Enables the third "OpenRouter" model option in both chat (via the
# openrouter-proxy sidecar, tools/openrouter_proxy.py) and the pentest agent
# (tools/pentest_agent.py --provider openrouter). Anthropic/Claude model ids
# are refused for the pentest agent regardless of this key - see
# PENTEST_APPLIANCE.md section 4.7. Unset: the OpenRouter option just isn't
# available, everything else is unaffected.
OPENROUTER_API_KEY=
